# Local Julia environments and generated data.
/Manifest.toml
/LocalPreferences.toml
/data/
__pycache__/
*.py[cod]
*.jld2
*.bson
*.html

# Root ignore rules exclude JSON and SVG; retain benchmark configuration/results.
!scripts/configs/*.json
!results/**/*.json
!results/**/*.svg

# Transient locks, partial writes, and raw process output.
results/**/.suite.lock
results/**/*.tmp
results/**/.plot-*
results/**/*.out

# Nsight captures/databases are ignored by the repository-wide rules.
